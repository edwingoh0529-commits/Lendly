<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lendly_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnBorrowBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Request to borrow"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtBorrowItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item name"
                android:textColor="@color/text_color_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Pickup date"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtBorrowDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="false"
                android:hint="YYYY-MM-DD"
                android:inputType="none"
                android:paddingHorizontal="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Return by"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtReturnDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="false"
                android:hint="YYYY-MM-DD"
                android:inputType="none"
                android:paddingHorizontal="14dp" />

            <TextView
                android:id="@+id/txtCostSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_pill"
                android:gravity="center"
                android:padding="14dp"
                android:text="Cost"
                android:textColor="@color/lendly_blue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Suggest where to meet"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMeetupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No meeting point chosen yet"
                android:textColor="@color/text_color_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtMeetupHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The owner suggested this spot."
                android:textColor="@color/grey_text"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickMeetup"
                style="@style/Lendly.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Choose meeting point on campus map" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="How will you pay?"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <AutoCompleteTextView
                android:id="@+id/actvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:paddingHorizontal="14dp"
                android:text="Cash" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="You pay the owner directly when you meet. Lendly does not handle money."
                android:textColor="@color/grey_text"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Message to the owner (optional)"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtBorrowMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_outline"
                android:gravity="top"
                android:hint="e.g. I need it for a lab session on Friday"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnSubmitRequest"
                style="@style/Lendly.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Send request"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="The owner will accept or reject this. You will see the reply in the Lends tab."
                android:textColor="@color/grey_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>