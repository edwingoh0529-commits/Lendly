<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Lendly.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/lendly_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/button_corner</item>
    </style>

    <style name="Lendly.Button.Green">
        <item name="backgroundTint">@color/accept_green</item>
    </style>

    <style name="Lendly.Button.Red">
        <item name="backgroundTint">@color/reject_red</item>
    </style>

    <style name="Lendly.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/lendly_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="strokeColor">@color/lendly_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Lendly.Button.Header" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="backgroundTint">#1FFFFFFF</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="cornerRadius">@dimen/button_corner_small</item>
        <item name="strokeColor">#59FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Lendly.Button.Card" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="cornerRadius">@dimen/button_corner_small</item>
    </style>

    <style name="Lendly.Button.Card.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/lendly_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="cornerRadius">@dimen/button_corner_small</item>
        <item name="strokeColor">@color/lendly_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Lendly.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_color_primary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Lendly.ToolbarTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Lendly.EmptyText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/grey_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>